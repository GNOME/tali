msgid "Tali"
msgstr "Tali"

#
#: data/org.gnome.Tali.desktop.in:3
msgid "Beat the odds in a poker-style dice game"
msgstr "Spel mot oddsen i eit terningspel i pokerstil"

#. TRANSLATORS: Do NOT translate or localize the semicolons!
#. The list MUST also end with a semicolon!
#. Search terms to find this application.
#: data/org.gnome.Tali.desktop.in:7
msgid "yahtzee;"
msgstr "yahtzee;yatzy;terningar;"

#: data/org.gnome.Tali.gschema.xml:11
msgid "Delay between rolls"
msgstr "Pause mellom kast"

#: data/org.gnome.Tali.gschema.xml:12
msgid ""
"Choose whether or not to insert a delay between the computer’s dice rolls so "
"the player can follow what it is doing."
msgstr ""
"Vel om det skal setjast inn ei forseinking mellom terningkasta til "
"datamaskina, slik at spelaren kan følgje med på kva datamaskina gjer."

#: data/org.gnome.Tali.gschema.xml:16
msgid "Display the computer’s thoughts"
msgstr "Vis tankane til datamaskina"

#: data/org.gnome.Tali.gschema.xml:17
msgid ""
"If set to true, a dump of the AI’s working will be done to standard output."
msgstr ""
"Viss verdien er true, vert ei utskrift av arbeidet til AI-en skriven til "
"standard utdata."

#: data/org.gnome.Tali.gschema.xml:20
msgctxt "PlayerNames"
msgid "[ 'Human', 'Alice', 'Bob', 'Carol', 'Dave', 'Eve' ]"
msgstr "[ 'Menneske', 'Alice', 'Bob', 'Carol', 'Dave', 'Eve' ]"

